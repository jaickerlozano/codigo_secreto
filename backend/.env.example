# Local development values only. Production configuration belongs to the deployment environment.
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace-with-a-local-development-secret
# For PostgreSQL concurrency tests, copy ../docker/postgres.env.example to
# ../docker/postgres.env, replace its password locally, and use the same value
# here. SQLite remains suitable for ordinary local development.
# DATABASE_URL=postgresql://codigo_secreto:replace-with-a-local-alphanumeric-password@127.0.0.1:5432/codigo_secreto

# Production topology is approved by the deployment owner and supplied outside this repository.
# FRONTEND_ORIGIN=https://<assigned-frontend-hostname>
# API_HOSTNAME=<assigned-api-hostname>
# ALLOWED_HOSTS=<assigned-api-hostname>
# CORS_ALLOWED_ORIGINS=https://<assigned-frontend-hostname>
# CSRF_TRUSTED_ORIGINS=https://<assigned-frontend-hostname>
# COOKIE_TOPOLOGY=shared-parent
# COOKIE_SITE_DOMAIN=<controlled-parent-domain>
# TLS_TERMINATION=proxy
# NUM_PROXIES=1
# SECURE_HSTS_SECONDS=3600
# LOG_LEVEL=INFO

# Secrets are injected by the secret custodian from the approved secret manager.
# DATABASE_URL=postgresql://<db-user>:<secret-manager-reference>@<db-host>:5432/<db-name>
# Transactional SMTP is disabled locally unless these values are explicitly supplied.
# Use a TLS-enabled SMTP account; keep the password only in an untracked local environment.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=<smtp-host>
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=<smtp-user>
# EMAIL_HOST_PASSWORD=<secret-manager-reference>
# DEFAULT_FROM_EMAIL=<sender-address>
# CLOUDINARY_CLOUD_NAME=<cloud-name>
# CLOUDINARY_API_KEY=<secret-manager-reference>
# CLOUDINARY_API_SECRET=<secret-manager-reference>
# CLOUDINARY_UPLOAD_PRESET=<approved-upload-preset>
# See ../docs/production-security.md before preparing a production environment.
